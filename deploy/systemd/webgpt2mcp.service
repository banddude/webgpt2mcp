[Unit]
Description=webgpt2mcp ChatGPT Web Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/npm start -- -xvfb -vnc
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
