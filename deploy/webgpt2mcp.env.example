# Public HTTPS URL ChatGPT/Claude will connect to.
PUBLIC_BASE=https://chatgpt-mcp.example.com

# Local service ports. Normally no reason to change these.
CHATGPT_API_URL=http://127.0.0.1:17841
MCP_UPSTREAM=http://127.0.0.1:17842/mcp
MCP_OAUTH_PORT=17843

# Runtime secrets/state stay outside Git.
OAUTH_STORE=/opt/webgpt2mcp/data/oauth-store.json
ADMIN_TOKEN_FILE=/opt/webgpt2mcp/data/oauth-admin-token
