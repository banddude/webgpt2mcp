#!/usr/bin/env python3
"""Command-line client for the local ChatGPT web-management API."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen


CONVERSATION_ID_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
    re.IGNORECASE,
)
CONVERSATION_URL_RE = re.compile(
    r"https://chatgpt\.com/c/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/?",
    re.IGNORECASE,
)
PROJECT_ID_RE = re.compile(r"g-p-[0-9a-z]+", re.IGNORECASE)
PROJECT_URL_RE = re.compile(
    r"https://chatgpt\.com/g/(g-p-[0-9a-z]+)(?:-[^/?#]+)?/?",
    re.IGNORECASE,
)

EXACT_CONVERSATION_ERROR = (
    "conversation must be an exact ChatGPT conversation ID or exact "
    "https://chatgpt.com/c/... URL; titles and fuzzy names are not accepted"
)
EXACT_PROJECT_ERROR = (
    "project must be an exact ChatGPT project ID (g-p-...) or exact "
    "https://chatgpt.com/g/g-p-... URL; project names are not accepted"
)
DEFAULT_LIST_LIMIT = 20
DEFAULT_SEARCH_LIMIT = 20
DEFAULT_PROJECT_LIMIT = 50
DEFAULT_PROJECT_CONVERSATION_LIMIT = 28
DEFAULT_TIMEOUT_SECONDS = 300


class ChatGPTError(Exception):
    """An API or local configuration error suitable for CLI output."""

    def __init__(self, message: str, *, status: int | None = None, data: Any = None):
        super().__init__(message)
        self.status = status
        self.data = data


class CliUsageError(ChatGPTError):
    """An invalid command argument."""


def _service_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _config_path() -> Path:
    configured = os.environ.get("CHATGPT_CONFIG")
    return Path(configured).expanduser() if configured else _service_root() / "data" / "config.yaml"


def _worker_registry_path() -> Path:
    configured = os.environ.get("CHATGPT_WORKER_REGISTRY")
    if configured:
        return Path(configured).expanduser()
    return _service_root() / "data" / "worker-registry.jsonl"


def _strip_yaml_comment(value: str) -> str:
    quote_char: str | None = None
    escaped = False
    for index, char in enumerate(value):
        if escaped:
            escaped = False
            continue
        if char == "\\" and quote_char == '"':
            escaped = True
            continue
        if char in {'"', "'"}:
            if quote_char is None:
                quote_char = char
            elif quote_char == char:
                quote_char = None
            continue
        if char == "#" and quote_char is None and (index == 0 or value[index - 1].isspace()):
            return value[:index].rstrip()
    return value.strip()


def _yaml_scalar(value: str) -> str:
    value = _strip_yaml_comment(value).strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        if value[0] == '"':
            try:
                parsed = json.loads(value)
            except json.JSONDecodeError as exc:
                raise ChatGPTError(f"invalid quoted value in {_config_path()}: {exc}") from exc
            if not isinstance(parsed, str):
                raise ChatGPTError(f"expected a string value in {_config_path()}")
            return parsed
        return value[1:-1].replace("''", "'")
    return value


def _read_server_config(path: Path) -> tuple[str, int]:
    """Read server.auth and server.port without requiring a YAML package."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise ChatGPTError(f"cannot read config file {path}: {exc}") from exc

    server_indent: int | None = None
    values: dict[str, str] = {}
    for raw_line in lines:
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        indent = len(raw_line) - len(raw_line.lstrip(" "))
        content = raw_line.strip()
        if server_indent is None:
            if re.fullmatch(r"server:\s*(?:#.*)?", content):
                server_indent = indent
            continue
        if indent <= server_indent:
            break
        match = re.fullmatch(r"(auth|port):\s*(.*?)\s*", content)
        if match:
            values[match.group(1)] = _yaml_scalar(match.group(2))

    auth = values.get("auth", "").strip()
    if not auth:
        raise ChatGPTError(f"server.auth is missing or empty in {path}")
    try:
        port = int(values.get("port", "17841"))
    except ValueError as exc:
        raise ChatGPTError(f"server.port is not an integer in {path}") from exc
    if not 1 <= port <= 65535:
        raise ChatGPTError(f"server.port is outside 1-65535 in {path}")
    return auth, port


def _endpoint() -> tuple[str, str]:
    auth, port = _read_server_config(_config_path())
    base_url = os.environ.get("CHATGPT_API_URL", f"http://127.0.0.1:{port}").rstrip("/")
    if not base_url:
        raise ChatGPTError("CHATGPT_API_URL cannot be empty")
    return base_url, auth


def _json_or_text(raw: bytes) -> Any:
    if not raw:
        return {}
    text = raw.decode("utf-8", errors="replace")
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        return text


def _error_message(data: Any, fallback: str) -> str:
    if isinstance(data, dict):
        error = data.get("error")
        if isinstance(error, dict):
            message = error.get("message") or error.get("error") or error.get("code")
            if message:
                return str(message)
        elif error:
            return str(error)
        if data.get("message"):
            return str(data["message"])
    if isinstance(data, str) and data.strip():
        return data.strip()
    return fallback


class ApiClient:
    def __init__(self) -> None:
        self.base_url, self.auth = _endpoint()
        try:
            self.timeout = float(os.environ.get("CHATGPT_CLI_TIMEOUT", DEFAULT_TIMEOUT_SECONDS))
        except ValueError as exc:
            raise ChatGPTError("CHATGPT_CLI_TIMEOUT must be a number") from exc
        if self.timeout <= 0:
            raise ChatGPTError("CHATGPT_CLI_TIMEOUT must be greater than zero")

    def request(
        self,
        method: str,
        path: str,
        *,
        query: dict[str, Any] | None = None,
        body: dict[str, Any] | None = None,
    ) -> Any:
        url = f"{self.base_url}{path}"
        if query:
            url = f"{url}?{urlencode({key: str(value) for key, value in query.items()})}"
        payload = json.dumps(body).encode("utf-8") if body is not None else None
        headers = {
            "Accept": "application/json",
            "Authorization": f"Bearer {self.auth}",
            "User-Agent": "chatgpt-cli/1.0",
        }
        if payload is not None:
            headers["Content-Type"] = "application/json"
        request = Request(url, data=payload, headers=headers, method=method.upper())
        try:
            with urlopen(request, timeout=self.timeout) as response:
                data = _json_or_text(response.read())
                status = getattr(response, "status", 200)
        except HTTPError as exc:
            data = _json_or_text(exc.read())
            raise ChatGPTError(
                _error_message(data, f"HTTP {exc.code}"),
                status=exc.code,
                data=data,
            ) from exc
        except (URLError, TimeoutError, OSError) as exc:
            raise ChatGPTError(f"local ChatGPT API is unreachable: {exc}") from exc

        if status >= 400:
            raise ChatGPTError(_error_message(data, f"HTTP {status}"), status=status, data=data)
        return data

    def request_stream(self, method: str, path: str, body: dict[str, Any]) -> dict[str, Any]:
        """POST an SSE chat completion and return it as a chat.completion object.

        The bridge accepts streaming submits even when its queue is full
        (non-streaming ones are rejected as SERVER_BUSY), and delivers the full
        text plus conversation_url in the final stop chunk.
        """
        request = Request(
            f"{self.base_url}{path}",
            data=json.dumps(body).encode("utf-8"),
            headers={
                "Accept": "text/event-stream",
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.auth}",
                "User-Agent": "chatgpt-cli/1.0",
            },
            method=method.upper(),
        )
        content_parts: list[str] = []
        model: str | None = None
        conversation_url: str | None = None
        completion_id: str | None = None
        try:
            # No socket timeout: the bridge sends no bytes while a queued task
            # waits for a browser slot, so any read timeout would abort a task
            # that is still going to run (and resubmitting would duplicate it).
            with urlopen(request, timeout=None) as response:
                for raw_line in response:
                    line = raw_line.decode("utf-8", errors="replace").strip()
                    if not line.startswith("data:"):
                        continue
                    payload = line[len("data:"):].strip()
                    if not payload or payload == "[DONE]":
                        continue
                    try:
                        event = json.loads(payload)
                    except json.JSONDecodeError:
                        continue
                    if not isinstance(event, dict):
                        continue
                    if event.get("error"):
                        raise ChatGPTError(_error_message(event, "ChatGPT returned an error"), data=event)
                    model = event.get("model") or model
                    completion_id = event.get("id") or completion_id
                    conversation_url = event.get("conversation_url") or conversation_url
                    choices = event.get("choices") or []
                    delta = ((choices[0] if choices else {}) or {}).get("delta") or {}
                    piece = delta.get("content")
                    if isinstance(piece, str):
                        content_parts.append(piece)
        except HTTPError as exc:
            data = _json_or_text(exc.read())
            raise ChatGPTError(
                _error_message(data, f"HTTP {exc.code}"),
                status=exc.code,
                data=data,
            ) from exc
        except (URLError, TimeoutError, OSError) as exc:
            raise ChatGPTError(f"local ChatGPT API is unreachable: {exc}") from exc

        return {
            "id": completion_id or "chatcmpl-cli",
            "object": "chat.completion",
            "model": model,
            "conversation_url": conversation_url,
            "choices": [
                {
                    "index": 0,
                    "message": {"role": "assistant", "content": "".join(content_parts)},
                    "finish_reason": "stop",
                }
            ],
        }


def _conversation_ref(value: str) -> tuple[str, str] | None:
    raw = value.strip()
    if CONVERSATION_ID_RE.fullmatch(raw):
        identifier = raw.lower()
        return identifier, f"https://chatgpt.com/c/{identifier}"
    match = CONVERSATION_URL_RE.fullmatch(raw)
    if match:
        identifier = match.group(1).lower()
        return identifier, f"https://chatgpt.com/c/{identifier}"
    return None


def _project_ref(value: str) -> str | None:
    raw = value.strip()
    if PROJECT_ID_RE.fullmatch(raw):
        return raw
    match = PROJECT_URL_RE.fullmatch(raw)
    return match.group(1) if match else None


def _require_conversation(value: str) -> tuple[str, str]:
    reference = _conversation_ref(value)
    if reference is None:
        raise CliUsageError(EXACT_CONVERSATION_ERROR)
    return reference


def _require_project(value: str) -> str:
    project_id = _project_ref(value)
    if project_id is None:
        raise CliUsageError(EXACT_PROJECT_ERROR)
    return project_id


def _positive_limit(value: str) -> int:
    try:
        number = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("limit must be an integer") from exc
    if number < 1:
        raise argparse.ArgumentTypeError("limit must be at least 1")
    return min(number, 50)


def _message(parts: Iterable[str], label: str) -> str:
    value = " ".join(parts).strip()
    if not value:
        raise CliUsageError(f"{label} is required")
    return value


def _print_json(data: Any) -> None:
    print(json.dumps(data, indent=2, ensure_ascii=False))


def _display_time(value: Any) -> str:
    if value is None or value == "":
        return "unknown"
    if isinstance(value, (int, float)):
        try:
            return datetime.fromtimestamp(value, tz=timezone.utc).isoformat()
        except (OverflowError, OSError, ValueError):
            pass
    return str(value)


def _conversation_lines(items: list[dict[str, Any]], *, empty: str) -> list[str]:
    if not items:
        return [empty]
    lines: list[str] = []
    for index, item in enumerate(items, start=1):
        identifier = item.get("id") or "unknown"
        lines.append(f"{index}. {item.get('title') or 'Untitled'}")
        lines.append(f"   ID: {identifier}")
        lines.append(f"   URL: {item.get('url') or f'https://chatgpt.com/c/{identifier}'}")
        if "stream_status" in item:
            lines.append(f"   Status: {item.get('stream_status') or 'UNKNOWN'}")
        if item.get("project_id"):
            lines.append(f"   Project: {item['project_id']}")
        lines.append(f"   Last activity: {_display_time(item.get('last_message_time') or item.get('update_time'))}")
        lines.append("")
    return lines[:-1]


def _project_lines(items: list[dict[str, Any]]) -> list[str]:
    if not items:
        return ["No ChatGPT projects found."]
    lines: list[str] = []
    for index, item in enumerate(items, start=1):
        identifier = item.get("id") or "unknown"
        lines.extend(
            [
                f"{index}. {item.get('title') or 'Untitled'}",
                f"   ID: {identifier}",
                f"   URL: {item.get('url') or f'https://chatgpt.com/g/{identifier}'}",
                f"   Last activity: {_display_time(item.get('last_interacted_at') or item.get('update_time'))}",
                "",
            ]
        )
    return lines[:-1]


def _readable_conversations(data: Any) -> list[dict[str, Any]]:
    items = data.get("items", []) if isinstance(data, dict) else []
    if not isinstance(items, list):
        return []
    result = []
    for item in items:
        if not isinstance(item, dict):
            continue
        # The search endpoint returns upstream items keyed by conversation_id.
        normalized = {
            **item,
            "id": item.get("id") or item.get("conversation_id") or "",
            "url": item.get("url") or f"https://chatgpt.com/c/{item.get('id') or item.get('conversation_id') or ''}",
        }
        result.append(normalized)
    return result


def _read_worker_lines(path: Path) -> list[dict[str, Any]]:
    """Read the append-only worker journal; malformed lines are skipped."""
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return []
    except OSError as exc:
        raise ChatGPTError(f"cannot read worker registry {path}: {exc}") from exc
    entries: list[dict[str, Any]] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(entry, dict) and entry.get("conversation_id"):
            entries.append(entry)
    return entries


def _worker_states(entries: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Collapse journal lines to one state per conversation; latest line wins."""
    states: dict[str, dict[str, Any]] = {}
    for entry in entries:
        identifier = str(entry.get("conversation_id", "")).lower()
        if not identifier:
            continue
        state = states.get(identifier)
        if state is None:
            states[identifier] = {
                "conversation_id": identifier,
                "url": entry.get("url") or f"https://chatgpt.com/c/{identifier}",
                "spawner": entry.get("spawner") or "unknown",
                "task": entry.get("task") or "",
                "model": entry.get("model") or "",
                "prompt": entry.get("prompt") or "",
                "status": entry.get("status") or "open",
                "ts": entry.get("ts") or "",
                "note": entry.get("note") or "",
            }
            continue
        # Close lines only carry status/ts/note, so the original spawn
        # attribution (spawner, task, model, url) must survive them.
        for key in ("status", "ts", "note", "spawner", "task", "model", "prompt", "url"):
            if entry.get(key):
                state[key] = entry[key]
    return list(states.values())


def _worker_age(value: str) -> str:
    """Humanized age of a journal timestamp, e.g. '45s', '12m', '3h', '2d'."""
    try:
        moment = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return "unknown age"
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=timezone.utc)
    seconds = max(0, int((datetime.now(timezone.utc) - moment).total_seconds()))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


def _select_workers(states: list[dict[str, Any]], *, show_closed: bool) -> list[dict[str, Any]]:
    selected = [state for state in states if show_closed or state["status"] == "open"]
    selected.sort(key=lambda state: state["ts"] or "", reverse=True)
    return selected


def _worker_lines(workers: list[dict[str, Any]]) -> list[str]:
    if not workers:
        return ["No workers to show."]
    lines: list[str] = []
    for index, worker in enumerate(workers, start=1):
        lines.append(
            f"{index}. [{worker['status']}] {worker['spawner']} | age {_worker_age(worker['ts'])}"
            f" | {_display_time(worker['ts'])}"
        )
        if worker.get("task"):
            lines.append(f"   Task: {worker['task']}")
        if worker.get("model"):
            lines.append(f"   Model: {worker['model']}")
        lines.append(f"   ID: {worker['conversation_id']}")
        lines.append(f"   URL: {worker['url']}")
        if worker.get("note"):
            lines.append(f"   Note: {worker['note']}")
        lines.append("")
    return lines[:-1]


def _cmd_workers_list(args: argparse.Namespace) -> list[dict[str, Any]]:
    show_closed = args.workers_command == "all"
    workers = _select_workers(_worker_states(_read_worker_lines(_worker_registry_path())), show_closed=show_closed)
    if args.json_output:
        _print_json(workers)
    elif workers:
        print("\n".join(_worker_lines(workers)))
    elif show_closed:
        print("The worker registry is empty.")
    else:
        print("No open workers in the registry.")
    return workers


def _cmd_workers_close(args: argparse.Namespace) -> dict[str, Any]:
    identifier, url = _require_conversation(args.conversation)
    entry = {
        "ts": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "conversation_id": identifier,
        "status": "closed",
        "note": args.note.strip(),
    }
    path = _worker_registry_path()
    known = any(
        str(item.get("conversation_id", "")).lower() == identifier
        for item in _read_worker_lines(path)
    )
    # Append-only journal: history is never rewritten; the latest line wins.
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError as exc:
        raise ChatGPTError(f"cannot append to worker registry {path}: {exc}") from exc
    if args.json_output:
        _print_json({"url": url, **entry})
    else:
        suffix = f" Note: {entry['note']}" if entry["note"] else ""
        print(f"Closed worker {identifier}.{suffix}")
        print(f"URL: {url}")
        if not known:
            print("Warning: that conversation was not in the registry; the close was recorded anyway.")
    return entry


def _cmd_conversations_list(client: ApiClient, args: argparse.Namespace) -> Any:
    data = client.request(
        "GET",
        "/admin/chatgpt/conversations",
        query={"offset": 0, "limit": args.limit, "include_status": 1},
    )
    if args.json_output:
        _print_json(data)
    else:
        print("\n".join(_conversation_lines(_readable_conversations(data), empty="No ChatGPT conversations found.")))
    return data


def _cmd_conversations_search(client: ApiClient, args: argparse.Namespace) -> Any:
    query = _message(args.query, "query")
    # Server-side search covers all conversations, not just the recent list.
    data = client.request("GET", "/admin/chatgpt/search", query={"q": query})
    matches = _readable_conversations(data)[: args.limit]
    if args.json_output:
        _print_json(data)
    elif matches:
        print("\n".join(_conversation_lines(matches, empty="")))
    else:
        print(f'No ChatGPT conversations matched "{query}".')
    return data


def _cmd_read(client: ApiClient, args: argparse.Namespace) -> Any:
    identifier, url = _require_conversation(args.conversation)
    data = client.request("GET", f"/admin/chatgpt/conversation/{identifier}")
    if args.json_output:
        _print_json(data)
        return data

    print(data.get("title") or "Untitled")
    print(f"ID: {identifier}")
    print(f"URL: {url}")
    print(f"Status: {data.get('stream_status') or 'UNKNOWN'}")
    messages = data.get("messages") if isinstance(data, dict) else None
    messages = messages if isinstance(messages, list) else []
    print(f"Messages: {len(messages)}")
    print("-" * 40)
    for index, message in enumerate(messages, start=1):
        role = "User" if message.get("role") == "user" else "Assistant"
        timestamp = _display_time(message.get("create_time"))
        model = f" | model: {message['model']}" if message.get("model") else ""
        print(f"{index}. {role} | {timestamp}{model}")
        print(message.get("text") or "")
        if index != len(messages):
            print()
    return data


def _cmd_send(client: ApiClient, args: argparse.Namespace) -> Any:
    _, url = _require_conversation(args.conversation)
    message = _message(args.message, "message")
    data = client.request(
        "POST",
        "/admin/chatgpt/dispatch",
        body={"conversation_url": url, "prompt": message},
    )
    if args.json_output:
        _print_json(data)
    else:
        behavior = (
            "The previous active response was stopped first, then the message was sent."
            if data.get("active_before")
            else "The message was sent to the idle conversation."
        )
        print(behavior)
        print(f"Conversation: {url}")
    return data


def _cmd_new(client: ApiClient, args: argparse.Namespace) -> Any:
    message = _message(args.message, "message")
    # Streamed submits are accepted even when the bridge queue is full;
    # non-streamed ones are rejected as SERVER_BUSY under load.
    data = client.request_stream(
        "POST",
        "/v1/chat/completions",
        body={
            "model": "gpt-instant",
            "messages": [{"role": "user", "content": message}],
            "stream": True,
        },
    )
    if args.json_output:
        _print_json(data)
    else:
        content = (((data.get("choices") or [{}])[0] or {}).get("message") or {}).get("content")
        print(content or "No response")
        conversation_url = data.get("conversation_url")
        if conversation_url:
            print(f"\nConversation: {conversation_url}")
    return data


def _cmd_dispatch(client: ApiClient, args: argparse.Namespace) -> Any:
    message = _message(args.message, "message")
    body: dict[str, Any] = {
        "model": args.model,
        "prompt": message,
    }
    if args.spawner:
        body["spawner"] = args.spawner
    if args.task:
        body["task"] = " ".join(args.task)
    # Dispatch confirms the exact user turn, then releases the browser lane.
    # ChatGPT continues the response server-side and the registry poller closes
    # the worker after a later conversation read reports completion.
    data = client.request("POST", "/admin/chatgpt/dispatch", body=body)
    if args.json_output:
        _print_json(data)
        return data
    conversation_url = data.get("conversation_url")
    if conversation_url:
        print(f"\nWorker chat: {conversation_url}")
        print("Submitted; ChatGPT continues server-side and the worker will close after completion.")
    return data


def _cmd_rename(client: ApiClient, args: argparse.Namespace) -> Any:
    _, url = _require_conversation(args.conversation)
    title = _message(args.title, "title")
    data = client.request("POST", "/admin/chatgpt/rename", body={"conversation_url": url, "title": title})
    if args.json_output:
        _print_json(data)
    else:
        print(f"Renamed conversation to \"{data.get('title') or title}\".")
        print(f"Conversation: {url}")
    return data


def _cmd_archive(client: ApiClient, args: argparse.Namespace, archived: bool) -> Any:
    _, url = _require_conversation(args.conversation)
    data = client.request(
        "POST",
        "/admin/chatgpt/archive",
        body={"conversation_url": url, "archived": archived},
    )
    if args.json_output:
        _print_json(data)
    else:
        state = "archived" if data.get("is_archived") else "active"
        print(f"Conversation \"{data.get('title') or 'Untitled'}\" is now {state}.")
        print(f"Conversation: {url}")
    return data


def _cmd_projects_list(client: ApiClient, args: argparse.Namespace) -> Any:
    data = client.request("GET", "/admin/chatgpt/projects", query={"limit": args.limit})
    projects = data.get("projects", []) if isinstance(data, dict) else []
    projects = projects if isinstance(projects, list) else []
    if args.json_output:
        _print_json(data)
    else:
        print("\n".join(_project_lines(projects)))
    return data


def _cmd_projects_create(client: ApiClient, args: argparse.Namespace) -> Any:
    name = _message(args.name, "name")
    data = client.request(
        "POST",
        "/admin/chatgpt/projects",
        body={"name": name, "instructions": ""},
    )
    if args.json_output:
        _print_json(data)
    else:
        project = data.get("project") if isinstance(data, dict) else None
        project = project if isinstance(project, dict) else {}
        identifier = project.get("id") or "unknown"
        print(f"Created ChatGPT project \"{project.get('title') or name}\".")
        print(f"ID: {identifier}")
        print(f"URL: {project.get('url') or f'https://chatgpt.com/g/{identifier}'}")
        if data.get("verified") is False:
            print("Warning: the new project was not confirmed in the project list.")
    return data


def _cmd_project_conversations(client: ApiClient, args: argparse.Namespace) -> Any:
    project_id = _require_project(args.project)
    data = client.request(
        "GET",
        f"/admin/chatgpt/projects/{quote(project_id, safe='')}/conversations",
        query={"limit": args.limit},
    )
    conversations = data.get("conversations", []) if isinstance(data, dict) else []
    conversations = conversations if isinstance(conversations, list) else []
    normalized = [
        {
            **item,
            "url": item.get("url") or f"https://chatgpt.com/c/{item.get('id', '')}",
        }
        for item in conversations
        if isinstance(item, dict)
    ]
    if args.json_output:
        _print_json(data)
    elif normalized:
        print("\n".join(_conversation_lines(normalized, empty="")))
    else:
        print(f"Project {project_id} has no conversations.")
    return data


def _cmd_move(client: ApiClient, args: argparse.Namespace) -> Any:
    _, url = _require_conversation(args.conversation)
    raw_project = args.project.strip()
    project = "none" if raw_project.casefold() == "none" else _require_project(raw_project)
    data = client.request("POST", "/admin/chatgpt/move", body={"conversation_url": url, "project": project})
    if args.json_output:
        _print_json(data)
    else:
        if data.get("project_id"):
            target = f"project {data['project_id']} ({data.get('moved_to') or 'no URL'})"
        else:
            target = "no project (removed from any project)"
        print(f"Moved conversation to {target}.")
        print(f"Conversation: {url}")
    return data


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="chatgpt",
        description="Manage ChatGPT conversations and projects through the local web bridge.",
    )
    parser.add_argument("--version", action="version", version="chatgpt 1.0")
    commands = parser.add_subparsers(dest="command", required=True)

    conversations = commands.add_parser("conversations", help="list or search conversations")
    conversation_commands = conversations.add_subparsers(dest="conversations_command", required=True)
    list_command = conversation_commands.add_parser("list", help="list recent conversations")
    list_command.add_argument("--limit", type=_positive_limit, default=DEFAULT_LIST_LIMIT)
    search_command = conversation_commands.add_parser("search", help="search recent conversation titles")
    search_command.add_argument("query", nargs="+", help="text to find in conversation titles")
    search_command.add_argument("--limit", type=_positive_limit, default=DEFAULT_SEARCH_LIMIT)

    read = commands.add_parser("read", help="read one exact conversation")
    read.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")

    send = commands.add_parser("send", help="send to one exact conversation")
    send.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")
    send.add_argument("message", nargs="+", help="message to send")

    new = commands.add_parser("new", help="create a new conversation")
    new.add_argument("message", nargs="+", help="first message")

    dispatch = commands.add_parser("dispatch", help="spawn a worker chat and register it")
    dispatch.add_argument("message", nargs="+", help="first message (the task prompt)")
    dispatch.add_argument("--spawner", default=None, help="name recorded for whoever spawned the worker")
    dispatch.add_argument("--task", nargs="+", default=None, help="short task description for the registry")
    dispatch.add_argument(
        "--model",
        default="gpt-instant",
        help="bridge model for the worker chat (gpt-instant, gpt-thinking, gpt-pro)",
    )

    rename = commands.add_parser("rename", help="rename one exact conversation")
    rename.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")
    rename.add_argument("title", nargs="+", help="new title")

    archive = commands.add_parser("archive", help="archive one exact conversation")
    archive.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")
    unarchive = commands.add_parser("unarchive", help="restore one exact conversation")
    unarchive.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")

    projects = commands.add_parser("projects", help="list or inspect projects")
    project_commands = projects.add_subparsers(dest="projects_command", required=True)
    project_list = project_commands.add_parser("list", help="list projects")
    project_list.add_argument("--limit", type=_positive_limit, default=DEFAULT_PROJECT_LIMIT)
    project_create = project_commands.add_parser("create", help="create a project")
    project_create.add_argument("name", nargs="+", help="name for the new project")
    project_conversations = project_commands.add_parser("conversations", help="list conversations in a project")
    project_conversations.add_argument("project", help="exact project ID or exact ChatGPT project URL")
    project_conversations.add_argument("--limit", type=_positive_limit, default=DEFAULT_PROJECT_CONVERSATION_LIMIT)

    move = commands.add_parser("move", help="move one exact conversation")
    move.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")
    move.add_argument("project", help="exact project ID or the literal none")

    workers = commands.add_parser("workers", help="show or close dispatched worker chats")
    worker_commands = workers.add_subparsers(dest="workers_command")
    worker_commands.add_parser("all", help="list every worker in the registry, open or closed")
    workers_close = worker_commands.add_parser("close", help="append a close line for one worker chat")
    workers_close.add_argument("conversation", help="exact conversation ID or exact ChatGPT URL")
    workers_close.add_argument("--note", default="", help="optional closing note")
    return parser


def _parse_args(argv: list[str]) -> argparse.Namespace:
    json_output = False
    remaining: list[str] = []
    for argument in argv:
        if argument == "--json":
            json_output = True
        else:
            remaining.append(argument)
    args = _build_parser().parse_args(remaining)
    args.json_output = json_output
    return args


def _dispatch(client: ApiClient, args: argparse.Namespace) -> Any:
    if args.command == "conversations":
        if args.conversations_command == "list":
            return _cmd_conversations_list(client, args)
        return _cmd_conversations_search(client, args)
    if args.command == "read":
        return _cmd_read(client, args)
    if args.command == "send":
        return _cmd_send(client, args)
    if args.command == "new":
        return _cmd_new(client, args)
    if args.command == "dispatch":
        return _cmd_dispatch(client, args)
    if args.command == "workers":
        if args.workers_command == "close":
            return _cmd_workers_close(args)
        return _cmd_workers_list(args)
    if args.command == "rename":
        return _cmd_rename(client, args)
    if args.command == "archive":
        return _cmd_archive(client, args, True)
    if args.command == "unarchive":
        return _cmd_archive(client, args, False)
    if args.command == "projects":
        if args.projects_command == "list":
            return _cmd_projects_list(client, args)
        if args.projects_command == "create":
            return _cmd_projects_create(client, args)
        return _cmd_project_conversations(client, args)
    if args.command == "move":
        return _cmd_move(client, args)
    raise CliUsageError(f"unknown command: {args.command}")


def main(argv: list[str] | None = None) -> int:
    try:
        args = _parse_args(list(sys.argv[1:] if argv is None else argv))
        _dispatch(ApiClient(), args)
        return 0
    except ChatGPTError as exc:
        if getattr(exc, "data", None) is not None and "--json" in (argv if argv is not None else sys.argv[1:]):
            print(json.dumps(exc.data, indent=2, ensure_ascii=False), file=sys.stderr)
        else:
            print(f"chatgpt: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
